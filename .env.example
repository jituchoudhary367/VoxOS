# Copy to .env and replace secrets before using production mode.
JARVIS_ENV=development
JARVIS_DEBUG=true
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8000

# LLM (required for real planning; tests use local fallbacks/mocks)
LLM_PROVIDER=groq
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Voice providers
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
TTS_PROVIDER=edge
EDGE_TTS_VOICE=en-US-AriaNeural

# Database / Redis
POSTGRES_USER=voxos
POSTGRES_PASSWORD=change-me
POSTGRES_DB=voxos
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional managed Redis URL; use rediss:// for TLS.
# REDIS_URL=rediss://default:change-me@redis.example:6380/0

# Security: use long random values in production.
JARVIS_SECRET_KEY=change-me
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256

# Filesystem safety
JARVIS_WORKSPACE_ROOT=~/VoxOSWorkspace
FILESYSTEM_STRICT_MODE=true
