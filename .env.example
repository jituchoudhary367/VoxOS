# Copy to .env and replace secrets before using production mode.
# The legacy JARVIS_* spelling of these keys still works.
VOX_ENV=development
VOX_DEBUG=true
VOX_HOST=0.0.0.0
VOX_PORT=8000

# LLM (required for real planning; tests use local fallbacks/mocks)
LLM_PROVIDER=groq
GROQ_API_KEY=
# More keys from other Groq accounts: GROQ_API_KEY_2, GROQ_API_KEY_3, ... (any
# number) and/or GROQ_API_KEYS, comma-separated. Rate limits are per
# account, so each key adds a full quota; calls go to whichever key has the
# most quota left and a throttled key is skipped. Check with:
#   python -m voxos.llm.check_keys
GROQ_API_KEYS=
# Vox paces each key to stay under Groq's per-minute limits instead of
# hitting them (free tier ~8000 tokens and 30 requests per minute per model).
# Raise on a paid plan; 0 turns pacing off.
LLM_KEY_TPM=7500
LLM_KEY_RPM=28
OPENROUTER_API_KEY=

# Where models run: cloud (Groq only), local (Ollama only: private, offline)
# or hybrid (Groq first, Ollama when Groq is down or out of quota).
# All of this is also editable in the app: Settings > Local models.
LLM_MODE=hybrid
OLLAMA_BASE_URL=http://localhost:11434
# One all-rounder for chat, planning, vision and code. qwen3.5:4b (3.4 GB)
# suits 16 GB of RAM; qwen3.5:9b (6.6 GB) if you have 24 GB or more.
OLLAMA_MODEL=qwen3.5:4b
# Optional per-job overrides; empty = use OLLAMA_MODEL.
OLLAMA_FAST_MODEL=
OLLAMA_STRONG_MODEL=
OLLAMA_VISION_MODEL=

# Voice providers
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
# nova-3 + multi handles Hindi/English code-switching in one stream.
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi
# Comma-separated terms to bias transcription towards (nova-3 only).
DEEPGRAM_KEYTERMS=VoxOS,Chrome,WhatsApp,Exotel
TTS_PROVIDER=deepgram
# Deepgram Aura streams into the pipeline; English only.
DEEPGRAM_TTS_VOICE=aura-2-thalia-en
# edge-tts is the fallback for Hindi/Hinglish replies Aura cannot speak.
EDGE_TTS_VOICE=en-US-AriaNeural

# Voice tuning. Raise vad_confidence / vad_min_volume in a noisy room;
# lower user_speech_timeout for faster replies at the risk of interrupting.
VOICE_SAMPLE_RATE=16000
VOICE_VAD_CONFIDENCE=0.8
VOICE_VAD_START_SECS=0.2
VOICE_VAD_STOP_SECS=0.4
VOICE_VAD_MIN_VOLUME=0.65
VOICE_USER_SPEECH_TIMEOUT=0.6
# Mic stays muted this long after VoxOS finishes speaking (echo suppression).
VOICE_ECHO_HANGOVER_SECS=0.4
# Transcript quality floor before a turn is sent to the agents.
VOICE_MIN_TRANSCRIPT_WORDS=2
VOICE_MIN_TRANSCRIPT_CONFIDENCE=0.35
# Playback rate for streamed TTS; must match what the voice produces.
VOICE_TTS_SAMPLE_RATE=24000

# Wake-up. Both work at once: say the wake word, or press the key.
# Tap the key for a hands-free session; hold it to talk (push-to-talk).
VOICE_HOTKEY=ctrl+space
VOICE_HOTKEY_HOLD_SECS=0.35
VOICE_WAKE_WORD_ENABLED=true
# openwakeword ships no "hey vox" model. "hey_jarvis" is the acoustic
# trigger until you train one; a custom .onnx path works here too.
VOICE_WAKE_WORD_MODELS=hey_jarvis
VOICE_WAKE_WORD_SENSITIVITY=0.6

# Database / Redis
POSTGRES_USER=voxos
POSTGRES_PASSWORD=change-me
POSTGRES_DB=voxos
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional managed Redis URL; use rediss:// for TLS.
# REDIS_URL=rediss://default:change-me@redis.example:6380/0

# Security: use long random values in production.
VOX_SECRET_KEY=change-me
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256

# Filesystem safety
VOX_WORKSPACE_ROOT=~/VoxWorkspace
FILESYSTEM_STRICT_MODE=true
